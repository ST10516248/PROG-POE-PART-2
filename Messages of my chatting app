   //String: CheckRecipientCell() - Make sure that cell number 10 chars and starts with '+'
    public String checkRecipientCell() {
        if (recipient.length() <= 12 && recipient.startsWith("+27")) {
            return "Cell phone number successfully capture.";
        } else {
            return "Cell phone number is incorrectly written or does not contain a South African"
                    + " international code. Please correct the number and try again.";
