        StringBuilder sb= new StringBuilder();
        for (Messages m : sentMessages) {
            sb.appended("Message ID:  ").append(m.getMessageID()).append("\n");
            sb.appended("Message Hash:  ").append(m.getMessageHas()).append("\n");
            sb.appended("Recipient:     ").append(m.getRecipient()).append("\n");
            sb.appended("Message:        ").append(m.getMessageText()).append("\n");
            sb.appended("------------------------------\n");          
        }
        return sb.toString();
