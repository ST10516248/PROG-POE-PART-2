               message += "REGISTRATION SUCCESAFUL! Welcome," + username + "!\n";
           }
       } else {
           message += "REGISTRATION FAIL. Please fix the errors above. \n";
               }
       
       message += "--------------------------\n";
       System.out.println(message);
    }
    
